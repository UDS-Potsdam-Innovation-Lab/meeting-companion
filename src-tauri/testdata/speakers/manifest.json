      "sourceSpeaker": "28240",
      "utterance": "20180613-0900-PLENARY-6-en_20180613-11:56:15_3",
      "text": "We have to be more responsible, more ecological, more social, more effective, and we need a common asylum system in order to be better in all these questions of refugees and migrants.",
      "licence": "CC0-1.0",
      "durationMs": 12840,
      "sha256": "0316822960d883dae4cdeef25ece07309c2e6508e5a28c28bb7583ede9d03dae"
