      "url": "https://huggingface.co/datasets/facebook/voxpopuli",
      "sourceSpeaker": "28240",
      "utterance": "20180911-0900-PLENARY-en_20180911-18:37:21_10",
      "text": "As in seeking to regulate Uber, when the Socialists wanted, for good reasons, to ensure that workers were paid, we want cultural workers to be paid as well.",
      "licence": "CC0-1.0",
      "durationMs": 8540,
      "sha256": "fbd49f0d0057455cc22ff079a0d0f6344438cfa4664b3281ec479105f1168436"
    },
    {
      "id": "en-f1-4",
      "file": "clips/en-f1-4.wav",
      "speaker": "en-f1",
      "lang": "en",
