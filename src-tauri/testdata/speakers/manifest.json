      "source": "VoxPopuli, transcribed test split (facebook/voxpopuli)",
      "url": "https://huggingface.co/datasets/facebook/voxpopuli",
      "sourceSpeaker": "28240",
      "utterance": "20181022-0900-PLENARY-en_20181022-19:40:42_3",
      "text": "I'm just back from the film festivals in Europe and we have to support our European films, not to leave it to Hollywood and Bollywood.",
      "licence": "CC0-1.0",
      "durationMs": 8760,
      "sha256": "7d2f9857c164e5dedcb03e4f62038747430388c1191e71dd0b7429ab9c44f19b"
    },
    {
