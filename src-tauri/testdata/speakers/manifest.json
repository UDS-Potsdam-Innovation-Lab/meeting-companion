      "utterance": "20180313-0900-PLENARY-12-de_20180313-16:59:29_1",
      "text": "Wir werden die Klimaziele von Paris nicht erfüllen können, wenn wir die europäische Landwirtschaft nicht ökologisieren.",
      "licence": "CC0-1.0",
      "durationMs": 6479,
      "sha256": "02c432f1e70320199e80dc90eae20f2b6a6315c6add15347df0cb24f6352cecc"
